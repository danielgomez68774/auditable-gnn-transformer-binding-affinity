# ---- Byte-compiled / cache ----
__pycache__/
*.py[cod]
*$py.class

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Packaging / build ----
build/
dist/
*.egg-info/
.eggs/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Heavy data & generated artifacts (NOT in git) ----
# Preprocessed graphs: download from Zenodo into data/
data/*
!data/README.md
# Trained checkpoints: generated by training / archived on Zenodo
trained_models/*
!trained_models/.gitkeep
# Figures, CSVs and logs produced by the scripts
outputs/*
!outputs/.gitkeep
# Loose weight / graph files anywhere
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.pkl

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
